---
import { DateTime } from 'luxon'
import { Icon } from 'astro-icon/components'
import { getCollection } from 'astro:content'

import Base from '../layouts/Base.astro'

import Section from '../components/Section.astro'
import Button from '../components/Button.astro'
import IconWithFallback from '../components/IconWithFallback.astro'
import con_dates from '../data/con/dates.json'
import Socials from '../content/socials.astro'
import ScheduleStatus from '../components/scheduleStatus.vue'
import { render_markdown } from '../helpers'

const openLocations = await getCollection('scheduleOpenLocations')
const order = ['Bar', 'Fursuit Lounge', "Dealers' Den"]
openLocations.sort((a, b) => order.indexOf(a.data.name) - order.indexOf(b.data.name))

const raw_tags = await getCollection('scheduleTags')
const raw_locations = await getCollection('scheduleLocations')
const raw_events = await getCollection('scheduleEvents')

function shortenTime(time: string) {
  const date = DateTime.fromISO(time)
  let h = `${date.hour}`
  if (date.hour < 10) {
    h = `0${h}`
  }
  let m = `${date.minute}`
  if (date.minute < 10) {
    m = `0${m}`
  }
  return `${h}:${m}`
}

const all_events = raw_events.map((re) => {
  const start_unix = DateTime.fromISO(`${re.data.day}T${re.data.start_time}`).toUnixInteger()
  return {
    id: re.id,
    title: re.data.title,
    description: re.data.description,
    host: re.data.host_name,
    start_unix,
    day: re.data.day,
    start: shortenTime(re.data.start_time),
    end: shortenTime(re.data.end_time),
    location: raw_locations.find((l) => l.id == re.data.schedule_location?.id.toString())?.data.name,
    tags: re.data.schedule_tags.map((t) => {
      const rt = raw_tags.find((rt) => rt.id == t.id.toString())
      // console.log(rt)
      if (!rt) {
        return undefined
      } else {
        return { name: rt.data.name, icon: rt.data.icon, color: rt.data.color }
      }
    })
  }
})
all_events.sort((a, b) => a.start_unix - b.start_unix)

const days: { date: string; weekday: string; shortdate: string }[] = []
function add_day(date: string) {
  if (!days.find((day) => day.date == date)) {
    const parsed = DateTime.fromISO(date).setLocale('en-US')
    const weekday = parsed.toLocaleString({ weekday: 'long' })
    const shortdate = parsed.toLocaleString({ day: 'numeric', month: 'short' })
    days.push({ date: date, weekday, shortdate })
    return true
  }

  return false
}

all_events.forEach((event) => add_day(event.day))
const missing_dates = con_dates.filter((con_date) => add_day(con_date))
days.sort((a, b) => a.date.localeCompare(b.date))

const first_date = days[0]?.date
const buttonid = Math.random().toString(36).slice(2, 11)
const eventsid = Math.random().toString(36).slice(2, 11)

function get_open_location_width_class(columns: number) {
  switch (columns) {
    case 2:
      return 'lg:basis-[calc((100%-1rem)/2)]'
    case 3:
      return 'xl:basis-[calc((100%-2rem)/3)]'
    case 4:
      return '2xl:basis-[calc((100%-3rem)/4)]'
    default:
      return 'basis-full'
  }
}
---

<style lang="scss">
  @use '../styles/charter';

  .event {
    &__status {
      font-weight: bold;
      text-transform: uppercase;
      font-family: var(--font-inter), sans-serif;

      &.upcoming {
        color: charter.$primary-800;
        background-color: #e6c2551a;
      }

      &.live {
        color: #0f8b83; // Flüüfff 25/Accent/700
        background-color: #e2f1f2; // Flüüfff 25/Primary/100
      }

      &.past {
        color: charter.$primary-800;
        background-color: #d6455d1a;
      }
    }

    &__labels {
      &--label {
        display: flex;
        flex-direction: column;
        font-family: var(--font-inter), sans-serif;

        border-top: 1px solid #5abbd8;

        &:first-child {
          border-top: none;
        }

        @media (min-width: 750px) {
          flex-direction: row;

          span:first-child {
            min-width: 250px;
            margin-bottom: 0;
          }
        }
      }
    }
  }

  .day-button {
    cursor: pointer;
  }

  .schedule__entry {
    border: 1px solid charter.$accent1-200;
    box-shadow: 0 1px 4px 0 rgba(25, 33, 61, 0.08);
  }

  svg.schedule__tag--icon {
    font-size: 20px;
  }

  .open_location--closed {
    opacity: 0.5;
    // display: none;
  }
</style>

<Base>
  <Section outerClass="bg-accent1-50" grid="grid-col-1 justify-items-center" innerClass="w-full" gap="gap-8">
    <h2 class="font-atari text-2xl md:text-3xl">Schedule</h2>
    <p class="text-center">
      Your guide to five days of Flüüfff, from the first day's warm-up to the last day's closing hugs.
    </p>
    <div
      data-id={buttonid}
      class="flex flex-wrap gap-2 justify-center"
      style="margin-left: -40px; margin-right: -40px;"
    >
      {
        days.map((d) => (
          <button
            data-date={d.date}
            class="p-2 text-neutral-50 bg-accent1-500 rounded font-semibold day-button size-16 md:size-auto"
          >
            <span class="inline md:hidden">
              {d.weekday.slice(0, 3)}
              <br />
              {d.shortdate.split(' ')[1]}
            </span>
            <span class="hidden md:inline">
              {d.weekday}, {d.shortdate}
            </span>
          </button>
        ))
      }
    </div>
    <div data-id={eventsid} class="flex flex-wrap w-full gap-4">
      {
        days.map((day) =>
          openLocations.map((openLocation) => {
            const opening_times_today = openLocation.data.opening_times.filter(
              (opening_time) => opening_time.day == day.date
            )
            const any_opening_times_today = opening_times_today.length > 0
            return (
              <section
                data-date={day.date}
                style="min-height: 82px;"
                class={`hidden flex flex-col gap-4 p-4 shadow-md bg-neutrals-50 rounded-md schedule__entry relative basis-full ${get_open_location_width_class(openLocations.length)}`}
              >
                <div class="flex justify-between items-center h-full font-bold">
                  <div class:list={['flex gap-2 items-center', { 'text-functional-error': !any_opening_times_today }]}>
                    <Icon class="text-xl" name="lucide:clock" />
                    <div class="flex flex-col">
                      {any_opening_times_today ? (
                        opening_times_today.map((opening_time) => (
                          <span>
                            {opening_time.start_time.replace(':00.000', '')}
                            {' - '}
                            {opening_time.end_time.replace(':00.000', '')}
                          </span>
                        ))
                      ) : (
                        <span>Closed today</span>
                      )}
                    </div>
                  </div>
                  <div class="flex gap-2" data-arrow-of-open-location={openLocation.id}>
                    {openLocation.data.name}
                    <Icon
                      class="text-xl cursor-pointer text-accent1-500"
                      style="margin-top: 2px;"
                      name="lucide:arrow-down"
                      onclick={`toggleOpenLocationDescription(this, '${openLocation.id}')`}
                    />
                    <Icon
                      class="text-xl cursor-pointer text-accent1-500 hidden"
                      style="margin-top: 2px;"
                      name="lucide:arrow-up"
                      onclick={`toggleOpenLocationDescription(this, '${openLocation.id}')`}
                    />
                  </div>
                </div>
                <div
                  data-bridge-of-open-location={openLocation.id}
                  class="max-xl:hidden hidden absolute bg-neutrals-50 schedule__entry"
                  style="height: 22px; left: -1px; right: -1px; bottom: -18px; border-top: 0; border-bottom: 0; box-shadow: none;"
                />
              </section>
            )
          })
        )
      }
      {
        openLocations.map((openLocation) => (
          <section
            data-description-of-open-location={openLocation.id}
            class="hidden lex flex-col gap-4 p-4 shadow-md bg-neutrals-50 schedule__entry basis-full"
            set:html={render_markdown(openLocation.data.description)}
          />
        ))
      }
      {
        missing_dates.map((date) => (
          <section
            data-date={date}
            class="flex flex-col gap-4 px-6 py-8 md:p-16 shadow-md bg-neutrals-50 rounded-md schedule__entry basis-full"
          >
            <h3 class="font-atari font-bold text-xl md:text-2xl text-center">Coming soon</h3>
            <div class="my-2 md:my-8">
              <p class="text-center">
                There’s nothing to see here yet because we’re still waiting on you to organise a panel on this day!
              </p>
              <br class="md:hidden" />
              <p class="text-center">We’re looking forward to seeing what you come up with.</p>
            </div>
            <div class="block md:flex justify-center">
              <Button outline accent1 to="/events#want-to-be-part-of-the-action" label="Host your own event" go />
            </div>
          </section>
        ))
      }
      {
        all_events.map((e) => (
          <section
            data-date={e.day}
            class="hidden flex flex-col gap-4 p-4 shadow-md bg-neutrals-50 rounded-md schedule__entry basis-full"
          >
            <div class="flex justify-between items-center">
              <p class="flex items-center gap-2">
                <Icon class="text-xl" name="lucide:clock" />
                {e.start} - {e.end}
              </p>
              <ScheduleStatus date={e.day} start={e.start} end={e.end} client:load />
            </div>
            <h3 class="font-atari font-bold text-xl md:text-2xl">{e.title}</h3>
            <div class="flex justify-between items-center">
              <p class="flex items-center gap-2">
                <Icon class="text-xl" name="lucide:map-pin" />
                {e.location || 'Unknown'}
              </p>
              <p class="flex items-center gap-2">
                <Icon class="text-xl" name="lucide:user-round" />
                {e.host || 'Unknown'}
              </p>
            </div>
            <div
              class="flex gap-1 text-accent1-500 items-center cursor-pointer select-none md:hidden"
              onclick={`toggleEventDescriptionAndTags(this, '${e.id}')`}
            >
              <span>See full event description</span>
              <Icon class="text-lg" name="lucide:arrow-down" />
              <Icon class="text-lg hidden" name="lucide:arrow-up" />
            </div>
            <section data-description-and-tags-of-event={e.id} class="flex flex-col gap-4 hidden md:flex">
              <div set:html={render_markdown(e.description)} />
              {e.tags.length != 0 ? <hr class="border-accent1-200" /> : ''}
              {e.tags.length != 0 ? (
                <div class="flex flex-wrap gap-2">
                  {e.tags
                    .filter((t) => t)
                    .map((t) => {
                      return (
                        <p class="p-2 flex gap-2 items-center uppercase bg-accent1-50 border rounded-sm border-accent1-200 font-bold">
                          <IconWithFallback name={t!.icon} class="schedule__tag--icon" style={`color: ${t!.color}`} />
                          {t!.name}
                        </p>
                      )
                    })}
                </div>
              ) : (
                ''
              )}
            </section>
          </section>
        ))
      }
    </div>
  </Section>
  <Section grid="grid-col-1 justify-items-center" gap="gap-6">
    <h2 class="font-atari text-2xl md:text-3xl text-center">Event labels explained</h2>
    <p class="text-center">
      Look out for these icons during the convention. They help you find events that match your vibe.
    </p>
    <div class="grid items-center mt-4 event__labels">
      {
        raw_tags
          .sort((a, b) => a.data.name.localeCompare(b.data.name))
          .filter((raw_tag) => raw_tag.data.explain)
          .map((t) => (
            <div class="p-4 event__labels--label">
              <span class="flex items-center gap-2 mb-2 uppercase font-bold">
                <IconWithFallback name={t.data.icon} class="schedule__tag--icon" style={`color: ${t.data.color}`} />
                {t.data.name}
              </span>
              <span class="flex">{t.data.description}</span>
            </div>
          ))
      }
    </div>
  </Section>
  <Socials />
</Base>

<script is:inline define:vars={{ buttonid, eventsid, first_date }}>
  const buttons = document.querySelectorAll(`[data-id="${buttonid}"] > button`)
  const events = document.querySelectorAll(`[data-id="${eventsid}"] > section`)

  // javascript web has no cleaner way to format the browser time YYYY-MM-DD
  const now = new Date()
  const today = new Date(now.getTime() - now.getTimezoneOffset() * 60 * 1000)

  let active_date = sessionStorage.getItem('schedule:active_date') ?? today.toISOString().split('T')[0]

  const setActiveDate = (d) => {
    active_date = d
    sessionStorage.setItem('schedule:active_date', active_date)

    // toggle active buttons
    buttons.forEach((b) => {
      b.classList.remove('bg-accent1-500')
      b.classList.remove('bg-accent1-800')
      b.classList.add(b.dataset.date == d ? 'bg-accent1-800' : 'bg-accent1-500')
    })

    // if none of the buttons are active (outdated/edited sessionstorage) use first
    if (!Array.from(buttons).some((b) => b.classList.contains('bg-accent1-800'))) {
      return setActiveDate(first_date)
    }

    // toggle visible events
    events.forEach((e) => {
      if (e.dataset.date) {
        if (e.dataset.date == d) {
          e.classList.remove('hidden')
        } else {
          e.classList.add('hidden')
        }
      }
    })
  }
  setActiveDate(active_date)

  buttons.forEach((b) => {
    b.addEventListener('click', () => setActiveDate(b.dataset.date))
  })

  window.toggleOpenLocationDescription = function (element, open_location_id) {
    const description = document.querySelector(`section[data-description-of-open-location="${open_location_id}"]`)
    description.classList.toggle('hidden')
    const descriptions = document.querySelectorAll(`section[data-description-of-open-location]`)
    descriptions.forEach((desc) => {
      if (desc != description) {
        desc.classList.add('hidden')
      }
    })

    const arrows = document.querySelectorAll(`div[data-arrow-of-open-location]`)
    arrows.forEach((arrow) => {
      arrow.querySelectorAll('svg').forEach((svg) => {
        const icon_to_hide =
          arrow.dataset.arrowOfOpenLocation == open_location_id && !description.classList.contains('hidden')
            ? 'lucide:arrow-down'
            : 'lucide:arrow-up'
        if (svg.dataset.icon == icon_to_hide) {
          svg.classList.add('hidden')
        } else {
          svg.classList.remove('hidden')
        }
      })
    })

    const bridges = document.querySelectorAll(`div[data-bridge-of-open-location]`)
    bridges.forEach((bridge) => {
      if (bridge.dataset.bridgeOfOpenLocation == open_location_id && !description.classList.contains('hidden')) {
        bridge.classList.remove('hidden')
      } else {
        bridge.classList.add('hidden')
      }
    })
  }

  window.toggleEventDescriptionAndTags = function (element, event_id) {
    Array.from(element.children).forEach((child) => {
      if (child.tagName == 'svg') child.classList.toggle('hidden')
    })

    const event = document.querySelector(`section[data-description-and-tags-of-event="${event_id}"]`)
    event.classList.toggle('hidden')
  }
</script>
