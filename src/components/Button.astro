---
import { Icon } from 'astro-icon/components'

interface Props {
  label: string
  to?: string
  primary?: boolean
  outline?: boolean
  accent1?: boolean
  go?: boolean
  newTab?: boolean
  download?: boolean
}

const {
  label,
  to,
  primary = false,
  outline = false,
  accent1 = false,
  go = false,
  newTab = false,
  download = false
} = Astro.props

const Element = to ? 'a' : 'button'
---

<Element href={to} class="button" class:list={{ primary, outline, accent1 }} target={newTab ? '_blank' : undefined}
  >{label}{!!go && <Icon name="mdi:arrow-right" />}{!!download && <Icon name="lucide:download" />}</Element
>

<style lang="scss" is:global>
  @use '../styles/charter';
  @use '../styles/text-styles';

  .button {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    text-decoration: none;
    outline: none;

    @include text-styles.display2SemiBold;
    padding: 14px 18px;
    gap: 3px;
    border-radius: 6px;
    line-height: 10px;

    background: charter.$secondary-500;
    color: charter.$neutrals-50;
    border: solid 1px charter.$secondary-500;

    &.outline {
      color: charter.$secondary-500;
      background: charter.$neutrals-50;
    }

    &.primary {
      color: charter.$neutrals-50;
      background: charter.$primary-500;
      border-color: charter.$primary-500;

      &.outline {
        background: charter.$neutrals-50;
        color: charter.$primary-500;
      }
    }

    &.accent1 {
      color: charter.$neutrals-50;
      background: charter.$accent1-500;
      border-color: charter.$accent1-500;

      &.outline {
        background: charter.$neutrals-50;
        color: charter.$accent1-500;
      }
    }

    > [data-icon] {
      font-size: 16px;
      margin: -3px 0 -3px 3px;
    }
  }
</style>
