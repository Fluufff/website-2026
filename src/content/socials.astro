---
import { Icon } from 'astro-icon/components'
---

<div class="socials">
  <div class="socials__container">
    <h2>Join the Flüüfff community!</h2>
    <div class="socials__list">
      <a href="https://t.me/fluufff_announcements" target="_blank" rel="noreferrer"
        ><Icon name="cib:telegram-plane" /></a
      >
      <a href="https://www.facebook.com/fluufff/" target="_blank" rel="noreferrer"><Icon name="mdi:facebook" /></a>
      <a href="https://twitter.com/FluufffCon" target="_blank" rel="noreferrer"><Icon name="ri:twitter-x-line" /></a>
      <a href="https://bsky.app/profile/did:plc:fei6suxorko4znzdnjl3wrik" target="_blank" rel="noreferrer"
        ><Icon name="ri:bluesky-fill" /></a
      >
      <a href="https://youtube.com/@fluufff" target="_blank" rel="noreferrer"><Icon name="ri:youtube-fill" /></a>
      <a href="https://barq.app/c/CGsmmrd" target="_blank" rel="noreferrer"><Icon name="barq-small" /></a>
    </div>
  </div>
</div>
<style lang="scss" is:global>
  @use '../styles/charter';
  @use '../styles/text-styles';

  .socials {
    padding: 80px 60px;
    display: flex;
    align-items: center;
    justify-content: center;

    @media (max-width: 600px) {
      padding: 20px 16px;
    }

    &__container {
      display: flex;
      max-width: 1400px;
      width: 100%;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 32px;
    }

    background: charter.$accent1-500;

    h2 {
      @include text-styles.heading2;
      margin: 0;
      font-size: 24px;
      line-height: 32px;
      color: charter.$neutrals-50;
      text-align: center;

      @media (max-width: 600px) {
        font-size: 14px;
        line-height: 28px;
      }
    }

    .socials__list {
      display: flex;
      flex-direction: row;
      row-gap: 16px;
      column-gap: 35px;

      @media (max-width: 480px) {
        column-gap: 5vw;
      }

      a {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 48px;
        width: 48px;
        background: charter.$neutrals-50;
        border-radius: 5px;

        [data-icon] {
          font-size: 24px;
          color: charter.$accent1-500;
          --barq-primary: #{charter.$neutrals-50};
          --barq-secondary: #{charter.$accent1-500};
        }
      }
    }
  }

  @media (max-width: 800px) {
    .socials {
      .socials__container {
        gap: 16px;
        flex-direction: column;
      }

      .socials__list {
        justify-content: center;
      }
    }
  }
</style>
